+EXPORT(void, sceClibMspaceMallocStats, Ptr<void> space, SceClibMspaceStats *stats) {
+    TRACY_FUNC(sceClibMspaceMallocStats, space, stats);
+    const std::lock_guard<std::mutex> guard(emuenv.kernel.mutex);
+
+    if (!space || !stats)
+        return;
+
+    const mspace heap = space.get(emuenv.mem);
+    const auto info = mspace_mallinfo(heap);
+    const auto capacity = static_cast<SceSize>(mspace_footprint(heap));
+    // dlmalloc's maximum system footprint is not peak live allocation usage.
+    *stats = { capacity, capacity, 0, static_cast<SceSize>(info.uordblks) };
+    LOG_WARN_ONCE("Mspace stats: capacity/current_in_use use allocator accounting; peak_in_use is unsupported and reported as zero");
 }
 
